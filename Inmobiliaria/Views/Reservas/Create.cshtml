@model Inmobiliaria.Models.Reserva
@{
    ViewData["Title"] = "Nueva reserva";
}
<h2>Nueva reserva</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <partial name="_BusquedaRemota" model='new Inmobiliaria.Models.BusquedaRemotaViewModel { Nombre = "InquilinoId", Etiqueta = "Inquilino", Url = Url.Action("Buscar", "Catalogos", new { entidad = "inquilinos" })!, IdSeleccionado = Model.InquilinoId > 0 ? Model.InquilinoId : null, TextoSeleccionado = ViewBag.InquilinoTexto }' />
        <span asp-validation-for="InquilinoId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <partial name="_BusquedaRemota" model='new Inmobiliaria.Models.BusquedaRemotaViewModel { Nombre = "InmuebleId", Etiqueta = "Inmueble disponible", Url = Url.Action("Buscar", "Catalogos", new { entidad = "inmuebles" })!, IdSeleccionado = Model.InmuebleId > 0 ? Model.InmuebleId : null, TextoSeleccionado = ViewBag.InmuebleTexto }' />
        <span asp-validation-for="InmuebleId" class="text-danger"></span>
    </div>
    <div class="row"><div class="col-md-4 mb-3"><label asp-for="FechaInicio" class="form-label"></label><input asp-for="FechaInicio" class="form-control" type="date" data-lookup-inicio /><span asp-validation-for="FechaInicio" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" class="form-control" type="date" data-lookup-fin /><span asp-validation-for="FechaFin" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="MontoDiario" class="form-label"></label><input asp-for="MontoDiario" class="form-control" type="number" min="0.01" step="0.01" /><span asp-validation-for="MontoDiario" class="text-danger"></span></div></div>
    <button type="submit" class="btn btn-success">Guardar reserva</button><a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
