@model Inmobiliaria.Models.DisponibilidadViewModel
@{
    ViewData["Title"] = "Buscar disponibilidad";
}
<h2>Buscar inmuebles disponibles</h2>
<form method="get" class="row g-3 mb-4">
    <div class="col-md-3"><label asp-for="FechaInicio" class="form-label"></label><input asp-for="FechaInicio" class="form-control" type="date" /></div>
    <div class="col-md-3"><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" class="form-control" type="date" /></div>
    <div class="col-md-3"><label asp-for="TipoInmuebleId" class="form-label">Tipo</label><select asp-for="TipoInmuebleId" asp-items="ViewBag.Tipos" class="form-select"><option value="">Todos</option></select></div>
    <div class="col-md-2"><label asp-for="CupoMinimo" class="form-label">Cupo mínimo</label><input asp-for="CupoMinimo" class="form-control" min="1" /></div>
    <div class="col-md-1 align-self-end"><button class="btn btn-primary" type="submit">Buscar</button></div>
</form>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (Model.Inmuebles.Count == 0)
{ <div class="alert alert-info">No hay inmuebles disponibles para ese período.</div> }
else
{
<table class="table table-striped"><thead class="table-dark"><tr><th>Inmueble</th><th>Tipo</th><th>Propietario</th><th>Cupo</th><th>Precio diario</th></tr></thead><tbody>
@foreach (var inmueble in Model.Inmuebles) { <tr><td>@inmueble.Nombre</td><td>@inmueble.Tipo?.Descripcion</td><td>@inmueble.Duenio?.Apellido, @inmueble.Duenio?.Nombre</td><td>@inmueble.Cupo</td><td>$@inmueble.PrecioPorDia.ToString("N2")</td></tr> }
</tbody></table>
}
<a asp-action="Index" class="btn btn-secondary">Volver</a>
