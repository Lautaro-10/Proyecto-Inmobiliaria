@model Inmobiliaria.Models.RenovarReservaViewModel
@{
    ViewData["Title"] = "Renovar reserva";
}
<h2>Renovar reserva #@Model.ReservaId</h2>
<p>Se creará una nueva reserva para <strong>@Model.Reserva?.Inquilino?.Apellido, @Model.Reserva?.Inquilino?.Nombre</strong> y el inmueble <strong>@Model.Reserva?.Inmueble?.Nombre</strong>.</p>
<form asp-action="Renovar" method="post">
    <input asp-for="ReservaId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row"><div class="col-md-4 mb-3"><label asp-for="FechaInicio" class="form-label"></label><input asp-for="FechaInicio" class="form-control" type="date" /><span asp-validation-for="FechaInicio" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" class="form-control" type="date" /><span asp-validation-for="FechaFin" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="MontoDiario" class="form-label"></label><input asp-for="MontoDiario" class="form-control" type="number" min="0.01" step="0.01" /><span asp-validation-for="MontoDiario" class="text-danger"></span></div></div>
    <button type="submit" class="btn btn-success">Crear renovación</button><a asp-action="Details" asp-route-id="@Model.ReservaId" class="btn btn-secondary ms-2">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
