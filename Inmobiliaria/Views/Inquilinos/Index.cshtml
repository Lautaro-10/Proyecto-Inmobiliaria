@model Inmobiliaria.Models.PaginadoViewModel<Inmobiliaria.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Inquilinos</h2>
    <a asp-action="Create" class="btn btn-primary" style="background-color: green; color: white; border: 2px white solid;">Nuevo inquilino</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-9"><input name="buscar" value="@Model.ValoresRuta.GetValueOrDefault("buscar")" class="form-control" placeholder="Buscar por nombre, DNI o email" /></div>
    <div class="col-md-3"><button type="submit" class="btn btn-secondary w-100">Buscar</button></div>
</form>

@if (Model.Elementos.Count == 0)
{
    <div class="alert alert-info">No hay inquilinos cargados.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>DNI</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inquilino in Model.Elementos)
            {
                <tr>
                    <td>@inquilino.Id</td>
                    <td>@inquilino.Nombre</td>
                    <td>@inquilino.Apellido</td>
                    <td>@inquilino.Dni</td>
                    <td>@inquilino.Telefono</td>
                    <td>@inquilino.Email</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@inquilino.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@inquilino.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
            <partial name="_Paginacion" model="Model" />
        </tbody>
    </table>
}
