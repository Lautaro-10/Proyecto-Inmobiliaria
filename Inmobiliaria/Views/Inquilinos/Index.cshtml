@model List<Inmobiliaria.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Inquilinos</h2>
    <a asp-action="Create" class="btn btn-primary">Nuevo inquilino</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay inquilinos cargados.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>DNI</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inquilino in Model)
            {
                <tr>
                    <td>@inquilino.Id</td>
                    <td>@inquilino.Nombre</td>
                    <td>@inquilino.Apellido</td>
                    <td>@inquilino.Dni</td>
                    <td>@inquilino.Telefono</td>
                    <td>@inquilino.Email</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@inquilino.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@inquilino.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
