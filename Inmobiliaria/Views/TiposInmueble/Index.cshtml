@model Inmobiliaria.Models.PaginadoViewModel<Inmobiliaria.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de inmueble";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tipos de inmueble</h2>
    <a asp-action="Create" class="btn btn-primary">Nuevo tipo</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-9"><input name="buscar" value="@Model.ValoresRuta.GetValueOrDefault("buscar")" class="form-control" placeholder="Buscar tipo" /></div>
    <div class="col-md-3"><button type="submit" class="btn btn-secondary w-100">Buscar</button></div>
</form>

@if (Model.Elementos.Count == 0)
{
    <div class="alert alert-info">No hay tipos de inmueble registrados.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr><th>Descripción</th><th>Acciones</th></tr>
        </thead>
        <tbody>
        @foreach (var tipo in Model.Elementos)
        {
            <tr>
                <td>@tipo.Descripcion</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@tipo.Id" class="btn btn-sm btn-warning">Editar</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@tipo.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    <partial name="_Paginacion" model="Model" />
}
