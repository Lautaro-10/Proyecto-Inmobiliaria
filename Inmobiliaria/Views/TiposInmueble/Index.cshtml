@model IEnumerable<Inmobiliaria.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de inmueble";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tipos de inmueble</h2>
    <a asp-action="Create" class="btn btn-primary">Nuevo tipo</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay tipos de inmueble registrados.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr><th>Descripción</th><th>Acciones</th></tr>
        </thead>
        <tbody>
        @foreach (var tipo in Model)
        {
            <tr>
                <td>@tipo.Descripcion</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@tipo.Id" class="btn btn-sm btn-warning">Editar</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@tipo.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
