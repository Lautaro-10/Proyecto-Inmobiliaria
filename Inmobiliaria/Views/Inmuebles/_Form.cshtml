@model Inmobiliaria.Models.Inmueble

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>
    <div class="col-12 mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <partial name="_BusquedaRemota" model='new Inmobiliaria.Models.BusquedaRemotaViewModel { Nombre = "PropietarioId", Etiqueta = "Propietario", Url = Url.Action("Buscar", "Catalogos", new { entidad = "propietarios" })!, IdSeleccionado = Model.PropietarioId > 0 ? Model.PropietarioId : null, TextoSeleccionado = ViewBag.PropietarioTexto }' />
        <span asp-validation-for="PropietarioId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <partial name="_BusquedaRemota" model='new Inmobiliaria.Models.BusquedaRemotaViewModel { Nombre = "TipoInmuebleId", Etiqueta = "Tipo de inmueble", Url = Url.Action("Buscar", "Catalogos", new { entidad = "tipos" })!, IdSeleccionado = Model.TipoInmuebleId > 0 ? Model.TipoInmuebleId : null, TextoSeleccionado = ViewBag.TipoTexto }' />
        <span asp-validation-for="TipoInmuebleId" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Cupo" class="form-label"></label>
        <input asp-for="Cupo" class="form-control" />
        <span asp-validation-for="Cupo" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="PrecioPorDia" class="form-label">Precio por día</label>
        <input asp-for="PrecioPorDia" class="form-control" />
        <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="PorcentajeReserva" class="form-label">Porcentaje de seña</label>
        <input asp-for="PorcentajeReserva" class="form-control" />
        <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Latitud" class="form-label"></label>
        <input asp-for="Latitud" class="form-control" />
        <span asp-validation-for="Latitud" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Longitud" class="form-label"></label>
        <input asp-for="Longitud" class="form-control" />
        <span asp-validation-for="Longitud" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="ImagenPortadaArchivo" class="form-label">Imagen de portada</label>
        <input asp-for="ImagenPortadaArchivo" type="file" accept=".png,.jpg,.jpeg,.webp" class="form-control" required="@(Model.Id == 0)" />
        <span asp-validation-for="ImagenPortadaArchivo" class="text-danger"></span>
        <div class="form-text">PNG, JPEG o WebP; máximo 5 MB. En edición, dejar vacío para conservar la portada actual.</div>
        @if (Model.Id > 0 && !string.IsNullOrWhiteSpace(Model.ImagenPortada))
        {
            <img src="@Model.ImagenPortada" alt="Portada actual de @Model.Nombre" class="img-thumbnail mt-2" style="max-width: 240px; max-height: 160px; object-fit: cover;" />
        }
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="ImagenesAdicionalesArchivos" class="form-label">Imágenes adicionales</label>
        <input name="ImagenesAdicionalesArchivos" type="file" accept=".png,.jpg,.jpeg,.webp" multiple class="form-control" />
        <span asp-validation-for="ImagenesAdicionalesArchivos" class="text-danger"></span>
        <div class="form-text">Puede seleccionar hasta 10 imágenes por vez; PNG, JPEG o WebP de hasta 5 MB cada una. En edición, las nuevas se agregan a la galería.</div>
        @if (!string.IsNullOrWhiteSpace(Model.ImagenesAdicionales))
        {
            <div class="d-flex flex-wrap gap-2 mt-2">
                @foreach (var imagen in Model.ImagenesAdicionales.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <img src="@imagen" alt="Imagen adicional actual de @Model.Nombre" class="img-thumbnail" style="width: 120px; height: 90px; object-fit: cover;" />
                }
            </div>
        }
    </div>
    <div class="col-12 mb-3 form-check ms-2">
        <input asp-for="Disponible" class="form-check-input" />
        <label asp-for="Disponible" class="form-check-label">Disponible para alquilar</label>
    </div>
</div>
