@model Inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Eliminar inmueble";
}

<h2>Eliminar inmueble</h2>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="alert alert-warning">
    ¿Está seguro de que desea eliminar el inmueble <strong>@Model.Nombre</strong>?
</div>
<dl class="row">
    <dt class="col-sm-3">Dirección</dt>
    <dd class="col-sm-9">@Model.Direccion</dd>
    <dt class="col-sm-3">Precio por día</dt>
    <dd class="col-sm-9">$@Model.PrecioPorDia.ToString("N2")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
