@model List<Inmobiliaria.Models.Pago>
@{
    var reserva = (Inmobiliaria.Models.Reserva)ViewBag.Reserva;
    ViewData["Title"] = "Pagos de la reserva";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Pagos de la reserva #@reserva.Id</h2>
        <p class="text-muted mb-0">@reserva.Inmueble?.Nombre · @reserva.Inquilino?.Nombre</p>
    </div>
    <a asp-action="Create" asp-route-reservaId="@reserva.Id" class="btn btn-primary">Nuevo pago</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay pagos registrados para esta reserva.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Fecha</th>
                <th>Concepto</th>
                <th>Importe</th>
                <th>Estado</th>
                <th style="width: 220px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var pago in Model)
        {
            <tr>
                <td>@pago.FechaPago?.ToString("dd/MM/yyyy")</td>
                <td>@pago.Concepto</td>
                <td>$@pago.Monto.ToString("N2")</td>
                <td>
                    <span class="badge @(pago.Estado == "Anulado" ? "bg-danger" : "bg-success")">@pago.Estado</span>
                </td>
                <td>
                    @if (pago.Estado != "Anulado")
                    {
                        <a asp-action="Edit" asp-route-id="@pago.Id" class="btn btn-sm btn-warning">Editar concepto</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Anular" asp-route-id="@pago.Id" class="btn btn-sm btn-danger">Anular</a>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<a asp-controller="Reservas" asp-action="Details" asp-route-id="@reserva.Id" class="btn btn-secondary">Volver a la reserva</a>
