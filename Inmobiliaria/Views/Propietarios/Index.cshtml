@model Inmobiliaria.Models.PaginadoViewModel<Inmobiliaria.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Propietarios</h2>
    <a asp-action="Create" class="btn btn-primary" style="margin-left: 10px;background-color: green;color: white; border:none;">Nuevo propietario</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-9"><input name="buscar" value="@Model.ValoresRuta.GetValueOrDefault("buscar")" class="form-control" placeholder="Buscar por nombre, DNI o email" /></div>
    <div class="col-md-3"><button type="submit" class="btn btn-secondary w-100">Buscar</button></div>
</form>

@if (Model.Elementos.Count == 0)
{
    <div class="alert alert-info">No hay propietarios cargados.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>DNI</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var propietario in Model.Elementos)
            {
                <tr>
                    <td>@propietario.Id</td>
                    <td>@propietario.Nombre</td>
                    <td>@propietario.Apellido</td>
                    <td>@propietario.Dni</td>
                    <td>@propietario.Telefono</td>
                    <td>@propietario.Email</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@propietario.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@propietario.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Paginacion" model="Model" />
}
